# Copia este archivo como .env (ignorado por git) y ajusta los valores.
# Las variables definidas en el entorno del sistema tienen prioridad sobre este archivo.

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/gestion_residuos
DB_USERNAME=postgres
DB_PASSWORD=cambia_esto

# Opcional: secreto para firmar los JWT (mínimo 32 caracteres; ej. openssl rand -base64 48).
# Si no se define se genera una clave temporal y las sesiones se pierden en cada reinicio
# (devtools reinicia la app al cambiar código, así que en desarrollo conviene definirlo).
# JWT_SECRET=cambia_esto

# Opcional: contraseña inicial de los usuarios de prueba que crea el seed.
# SEED_DEFAULT_PASSWORD=cambia_esto

# --- Despliegue con Docker Compose (docker-compose.yml) ---
# El compose lee estas variables; en Dokploy van en la pestaña Environment del servicio.
# Son obligatorias: DB_PASSWORD, JWT_SECRET (mínimo 32 caracteres) y SEED_DEFAULT_PASSWORD.
# CORS_ALLOWED_ORIGINS=http://tu-servidor:8080
# FRONTEND_PORT=8080
# SEED_ENABLED=true
