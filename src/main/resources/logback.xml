<configuration>
    <!-- Muestra los logs en la consola del IDE -->
    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Guarda los logs en un archivo físico -->
    <appender name="ARCHIVO" class="ch.qos.logback.core.FileAppender">
        <file>logs/ecoandina.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Nivel mínimo de logs a registrar (INFO) -->
    <root level="INFO">
        <appender-ref ref="CONSOLA" />
        <appender-ref ref="ARCHIVO" />
    </root>
</configuration>